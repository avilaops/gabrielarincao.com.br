---
import { site } from '../data/site';
import { linkWhatsApp, linkInstagram, linkEmail } from '../lib/contato';
import IconeWhatsApp from './IconeWhatsApp.astro';
import IconeInstagram from './IconeInstagram.astro';
import { estudio } from '../data/estudio';
import { enderecoPorExtenso, horarioPorExtenso } from '../lib/estudio';

const ano = new Date().getFullYear();
---
<footer id="contato" class="bg-carvao pt-16 pb-8 text-center text-marfim/80">
  <div class="container-site">
    <p class="font-display text-3xl text-ouro">{site.nome}</p>
    <p class="mt-2">{site.especialidades}</p>
    <p class="mt-1 text-sm text-marfim/65">6 anos transformando olhares com técnica e elegância</p>

    <ul class="mt-10 flex flex-wrap justify-center gap-x-8 gap-y-4">
      <li><a href={linkInstagram} target="_blank" rel="noopener" class="flex items-center gap-2 hover:text-ouro"><IconeInstagram /> Instagram</a></li>
      <li><a href={linkWhatsApp()} target="_blank" rel="noopener" class="flex items-center gap-2 hover:text-ouro"><IconeWhatsApp /> WhatsApp</a></li>
      <li><a href={linkEmail} class="flex items-center gap-2 hover:text-ouro">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        E-mail</a></li>
    </ul>

    {(estudio.endereco || estudio.horarios.length > 0) && (
      <div class="mx-auto mt-10 max-w-xl space-y-2 text-sm">
        {estudio.endereco && <address class="not-italic">{enderecoPorExtenso(estudio.endereco)}</address>}
        {estudio.horarios.map((h) => <p>{horarioPorExtenso(h)}</p>)}
        {estudio.mapsUrl && (
          <a href={estudio.mapsUrl} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-2 text-ouro hover:underline">Como chegar</a>
        )}
      </div>
    )}

    <div class="mt-12 flex flex-col items-center justify-center gap-2 border-t border-marfim/10 pt-8 text-sm text-marfim/65 sm:flex-row sm:gap-6">
      <p>© {ano} {site.nome} - Todos os direitos reservados</p>
      <p>Imagens ilustrativas</p>
      <a href={site.desenvolvidoPor.url} target="_blank" rel="noopener" class="hover:text-ouro">Desenvolvido por {site.desenvolvidoPor.nome}</a>
    </div>
  </div>
</footer>
