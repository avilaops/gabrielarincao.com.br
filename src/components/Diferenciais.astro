---
import { Image } from 'astro:assets';
import medicao from '../assets/img/medicao-proporcoes.jpg';

const itens = [
  {
    titulo: 'Técnica Profissional',
    texto: 'Anos de experiência com as melhores técnicas de design de sobrancelhas',
    icone: 'M12 3l2.5 5.5L20 9.3l-4 4 1 5.7-5-2.8-5 2.8 1-5.7-4-4 5.5-.8z',
  },
  {
    titulo: 'Resultado Personalizado',
    texto: 'Cada rosto é único. Criamos o design perfeito para você',
    icone: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-5a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0-3a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z',
  },
  {
    titulo: 'Ambiente Premium',
    texto: 'Espaço exclusivo, aconchegante e pensado para seu conforto',
    icone: 'M6 3h12l3 6-9 12L3 9zm-3 6h18M9 3l3 18 3-18',
  },
];
---
<section class="secao bg-white" aria-labelledby="titulo-diferenciais">
  <div class="container-site grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
    <div class="revelar relative">
      <Image
        src={medicao}
        alt="Medição das proporções do rosto com compasso antes do desenho da sobrancelha"
        widths={[480, 720, 960]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        class="aspect-[4/3] w-full rounded-2xl object-cover shadow-media lg:aspect-[4/5]"
      />
      <div class="absolute -right-3 -bottom-3 -z-10 hidden size-40 rounded-2xl border border-ouro/60 lg:block" aria-hidden="true"></div>
    </div>

    <div class="revelar">
      <p class="text-xs font-medium uppercase tracking-[0.3em] text-cafe-medio">O estúdio</p>
      <h2 id="titulo-diferenciais" class="mt-3 text-3xl font-semibold sm:text-4xl">Por Que Escolher Nosso Estúdio?</h2>
      <ul class="mt-10 space-y-8">
        {itens.map((i) => (
          <li class="flex gap-5">
            <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-marfim">
              <svg class="size-6 text-ouro" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
                <path d={i.icone} />
              </svg>
            </span>
            <div>
              <h3 class="text-xl font-semibold">{i.titulo}</h3>
              <p class="mt-1">{i.texto}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
