---
import { Image } from 'astro:assets';
import fundo from '../assets/img/estudio-desfocado.avif';
import sobrancelha from '../assets/img/sobrancelha-escovinha.jpg';
import { linkWhatsApp } from '../lib/contato';
import IconeWhatsApp from './IconeWhatsApp.astro';
---
<section id="inicio" class="relative isolate overflow-hidden bg-carvao text-marfim">
  <Image
    src={fundo}
    alt=""
    widths={[640, 832]}
    sizes="100vw"
    loading="eager"
    class="absolute inset-0 -z-10 size-full object-cover opacity-25"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-br from-carvao/50 via-carvao/80 to-carvao"></div>

  <div class="container-site grid items-center gap-12 py-16 sm:py-20 lg:min-h-[86svh] lg:grid-cols-[1.1fr_0.9fr] lg:gap-16 lg:py-24">
    <div class="text-center lg:text-left">
      <p class="mb-5 text-[0.7rem] font-medium uppercase tracking-[0.18em] text-ouro sm:text-xs sm:tracking-[0.3em]">Design de sobrancelhas · Brow Lamination · Nanofios</p>
      <h1 class="text-4xl leading-[1.08] font-bold text-marfim sm:text-6xl">
        Realce Sua <span class="italic text-champanhe">Beleza Natural</span>
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-lg text-marfim/80 sm:text-xl lg:mx-0">
        Design de sobrancelhas com técnica, precisão e elegância
      </p>
      <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start">
        <a href={linkWhatsApp()} target="_blank" rel="noopener" class="btn-ouro w-full sm:w-auto">
          <IconeWhatsApp /> Agende pelo WhatsApp
        </a>
        <a href="#servicos" class="btn-claro w-full sm:w-auto">Ver serviços</a>
      </div>
      <ul class="mt-10 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-marfim/70 lg:justify-start">
        {['6 anos de experiência', 'Design personalizado', 'Agendamento pelo WhatsApp'].map((t) => (
          <li class="flex items-center gap-2">
            <svg class="size-4 text-ouro" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m5 12 5 5L20 7" /></svg>
            {t}
          </li>
        ))}
      </ul>
    </div>

    <figure class="relative mx-auto w-full max-w-[17rem] sm:max-w-sm lg:max-w-md">
      <div class="absolute -inset-3 rounded-t-full border border-ouro/50" aria-hidden="true"></div>
      <Image
        src={sobrancelha}
        alt="Sobrancelha cheia e bem desenhada sendo penteada com escovinha"
        widths={[360, 540, 720]}
        sizes="(min-width: 1024px) 448px, (min-width: 640px) 384px, 272px"
        loading="eager"
        fetchpriority="high"
        class="relative aspect-[4/5] w-full rounded-t-full object-cover object-[60%_center] shadow-media"
      />
    </figure>
  </div>
</section>
