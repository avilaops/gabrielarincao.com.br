---
import { perguntas } from '../data/faq';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: perguntas.map((p) => ({
    '@type': 'Question',
    name: p.pergunta,
    acceptedAnswer: { '@type': 'Answer', text: p.resposta },
  })),
};
---
<section id="duvidas" class="secao bg-white" aria-labelledby="titulo-duvidas">
  <div class="container-site max-w-3xl">
    <h2 id="titulo-duvidas" class="titulo-secao">Dúvidas Frequentes</h2>
    <div class="revelar mt-12 divide-y divide-taupe/50 border-y border-taupe/50">
      {perguntas.map((p) => (
        <details class="group py-5" name="duvidas" data-pergunta>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-lg text-cafe [&::-webkit-details-marker]:hidden">
            {p.pergunta}
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-ouro text-cafe transition group-open:rotate-45" aria-hidden="true">
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" /></svg>
            </span>
          </summary>
          <p class="mt-3 pr-14">{p.resposta}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>
