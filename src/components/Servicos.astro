---
import { getCollection } from 'astro:content';
import { linkWhatsAppServico } from '../lib/contato';

const servicos = (await getCollection('servicos')).sort((a, b) => a.data.ordem - b.data.ordem);
---
<section id="servicos" class="secao" aria-labelledby="titulo-servicos">
  <div class="container-site">
    <h2 id="titulo-servicos" class="titulo-secao">Nossos Serviços</h2>
    <ul class="mt-14 flex flex-wrap justify-center gap-6">
      {servicos.map(({ data: s }) => (
        <li class="flex w-full flex-col rounded-2xl md:w-[calc(50%-0.75rem)] lg:w-[calc((100%-3rem)/3)] border border-taupe/50 bg-white p-8 shadow-suave transition hover:border-ouro hover:shadow-media" data-servico>
          <h3 class="text-2xl font-semibold">{s.titulo}</h3>
          <p class="mt-3">{s.descricao}</p>
          <p class="mt-6 font-display text-3xl font-semibold text-cafe" data-preco>{s.preco}</p>
          <ul class="mt-6 space-y-2 border-t border-marfim pt-6 text-sm">
            {s.beneficios.map((b) => (
              <li class="flex gap-2">
                <svg class="mt-0.5 size-4 shrink-0 text-ouro" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m5 12 5 5L20 7" /></svg>
                {b}
              </li>
            ))}
          </ul>
          <a href={linkWhatsAppServico(s.titulo)} target="_blank" rel="noopener" class="btn-escuro mt-8 w-full">
            Agendar<span class="sr-only"> {s.titulo}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
