---
import { Image } from 'astro:assets';
import mapeamento from '../assets/img/mapeamento-sobrancelha.jpg';

const passos = [
  { titulo: 'Agendamento', texto: 'Entre em contato pelo WhatsApp e escolha seu horário' },
  { titulo: 'Análise', texto: 'Estudamos seu rosto e desenhamos o design ideal' },
  { titulo: 'Execução', texto: 'Realizamos o procedimento com técnica e cuidado' },
  { titulo: 'Resultado', texto: 'Você sai linda e confiante para arrasar!' },
];
---
<section id="como-funciona" class="secao bg-white" aria-labelledby="titulo-como-funciona">
  <div class="container-site grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
    <div class="lg:order-2">
      <Image
        src={mapeamento}
        alt="Mapeamento da sobrancelha com linhas de referência antes do procedimento"
        widths={[480, 720, 960]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        class="aspect-[4/3] w-full rounded-2xl object-cover shadow-media"
      />
    </div>

    <div>
      <p class="text-xs font-medium uppercase tracking-[0.3em] text-cafe-medio">Passo a passo</p>
      <h2 id="titulo-como-funciona" class="mt-3 text-3xl font-semibold sm:text-4xl">Como Funciona</h2>
      <ol class="mt-10 space-y-6 border-l border-taupe/60 pl-8">
        {passos.map((p, i) => (
          <li class="relative">
            <span class="absolute top-0 -left-[3.05rem] flex size-9 items-center justify-center rounded-full border border-ouro bg-white font-display text-cafe" aria-hidden="true">{i + 1}</span>
            <h3 class="text-xl font-semibold"><span class="sr-only">Passo {i + 1}: </span>{p.titulo}</h3>
            <p class="mt-1">{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
