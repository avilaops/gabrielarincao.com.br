---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Diferenciais from '../components/Diferenciais.astro';
import Servicos from '../components/Servicos.astro';
import Galeria from '../components/Galeria.astro';
import Sobre from '../components/Sobre.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Depoimentos from '../components/Depoimentos.astro';
import Faq from '../components/Faq.astro';
import Instagram from '../components/Instagram.astro';
import ChamadaFinal from '../components/ChamadaFinal.astro';
import Footer from '../components/Footer.astro';
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
---
<Base>
  <Header />
  <main id="conteudo">
    <Hero />
    <Sobre />
    <Diferenciais />
    <Servicos />
    <Galeria />
    <ComoFunciona />
    <Depoimentos />
    <Faq />
    <Instagram />
    <ChamadaFinal />
  </main>
  <Footer />
  <BotaoWhatsApp />
</Base>
